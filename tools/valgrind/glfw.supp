# libGLdispatch keeps per-thread X11 dispatch data after GLFW terminates.
# These stacks were generated by Valgrind on ubuntu-latest and are limited to
# allocations made while GLFW connects to X11.
{
   gl_dispatch_x11_calloc
   Memcheck:Leak
   match-leak-kinds: definite
   fun:calloc
   obj:*
   obj:*
   fun:_glfwConnectX11
}
{
   gl_dispatch_x11_malloc
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   obj:*
   obj:*
   fun:_glfwConnectX11
}
{
   gl_dispatch_x11_indirect_malloc
   Memcheck:Leak
   match-leak-kinds: indirect
   fun:malloc
   obj:*
   obj:*
   obj:*
   fun:_glfwConnectX11
}
